#include <tunables/global>
profile rwa-flow-pilot flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  capability net_admin,
  capability sys_ptrace,
  network netlink raw,
  network unix stream,
  ptrace (read) peer=unconfined,
  ptrace (read, readby) peer=rwa-flow-pilot,
  signal (receive) peer=unconfined,
  signal (send, receive) peer=rwa-flow-pilot,
  /usr/local/bin/python* ixr,
  /usr/bin/nft ixr,
  /usr/sbin/nft ixr,
  /usr/local/lib/** mr,
  /usr/lib/** mr,
  /lib/** mr,
  /etc/ld.so.cache r,
  /etc/localtime r,
  /etc/nsswitch.conf r,
  /pilot/flow_guard.py r,
  /run/ndpi/ndpid-distributor.sock rw,
  /state/ rw,
  /state/** rwk,
  /tmp/ rw,
  /tmp/** rwk,
  /proc/ r,
  /proc/[0-9]*/ r,
  /proc/[0-9]*/comm r,
  /proc/[0-9]*/exe r,
  /proc/[0-9]*/fd/ r,
  /proc/[0-9]*/fd/* r,
  /proc/net/{tcp,tcp6,udp,udp6} r,
  /proc/[0-9]*/net/{tcp,tcp6,udp,udp6} r,
  /proc/sys/kernel/osrelease r,
  /usr/local/bin/xray r,
  deny /proc/[0-9]*/mem rw,
  deny /proc/[0-9]*/environ r,
  deny /proc/[0-9]*/root/** rwklx,
  deny mount,
  deny umount,
}
